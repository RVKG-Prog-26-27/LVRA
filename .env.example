# Copy this file to ".env" and adjust the values.

# "mock" = temporary sample recognition (default, no server needed)
# "api"  = send images to the real recognition server
VITE_RECOGNITION_MODE=mock

# Base address of the recognition server, used only when VITE_RECOGNITION_MODE=api.
# The app sends images to <this address>/recognize
VITE_RECOGNITION_API_URL=https://example.com/api

# Contact email shown in the privacy notice. PLACEHOLDER: replace before publishing.
VITE_PRIVACY_CONTACT_EMAIL=kontakti@example.com
